+static int imx296_set_gain(struct imx296 *imx296, s64 val)
+{	
+	int err;
+	u32 gain;
+	unsigned short reg_value_h, reg_value_l;
+	
+	gain = val * 10;
+	
+	reg_value_h = gain >> 8;
+	reg_value_l = gain & 0xFF;
+	
+	err = imx296_write_reg(imx296, GAIN_LOW, reg_value_l);
+	if (err){
+	    dev_dbg(imx296->dev, "%s: GAIN control error\n", __func__);
+	    return err;
+    	}
+    	
+    	err = imx296_write_reg(imx296, GAIN_HIGH, reg_value_h);
+	if (err){
+	    dev_dbg(imx296->dev, "%s: GAIN control error\n", __func__);
+	    return err;
+    	}
+    	
+    	pr_info("Input value set gain: %d", val);
+
+	return 0;
+}
+
+static int imx296_set_exposure(struct imx296 *imx296, s32 val)
+{	
+	int err;
+	u32 reg_shs;
+	u64 hmax;
+	u32 integration_time_line;
+    	u32 integration_offset = IMX296_INTEGRATION_OFFSET;
+    	u32 line_time;
+    	u32 frame_length;
+
+	dev_dbg(imx296->dev, "%s:++\n", __func__);
+
+    	err = imx296_read_buffered_reg(imx296, HMAX_LOW, 2, &hmax);
+    	if (err) {
+        	dev_err(imx296->dev, "%s: unable to read hmax\n", __func__);
+        	return err;
+    	}
+
+    	line_time = (hmax*IMX296_G_FACTOR) / (IMX296_INCK);
+	
+	integration_time_line = ((100*val - integration_offset)
+                                     * IMX296_K_FACTOR) / line_time ;
+                                     
+        frame_length = IMX296_G_FACTOR / (imx296_framerates[IMX296_30_FPS] * line_time);
+
+	reg_shs = frame_length - integration_time_line;
+	
+	if (reg_shs < IMX296_MIN_SHR0_LENGTH)
+        	reg_shs = IMX296_MIN_SHR0_LENGTH;
+	else if (reg_shs > (frame_length - IMX296_MIN_INTEGRATION_LINES))
+		reg_shs = frame_length - IMX296_MIN_INTEGRATION_LINES;
+		
+	err = imx296_write_buffered_reg (imx296, SHS1_LOW, 3, reg_shs);
+   	if (err) {
+        	dev_err(imx296->dev, "%s: failed to set frame length\n", __func__);
+        return err;
+    	}
+	
+	return 0;
+}
+
+static int imx296_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx296 *imx296 = container_of(ctrl->handler,
+					     struct imx296, ctrls);
+	int ret;
+
+	mutex_lock(&imx296->power_lock);
+	if (!imx296->power_count) {
+		mutex_unlock(&imx296->power_lock);
+		return 0;
+	}
+
+	switch (ctrl->id) {
+	case V4L2_CID_TEST_PATTERN:
+		ret = imx296_set_test_pattern(imx296, ctrl->val);
+		break;
+// [ISP Support PKG] Enabled to set GAIN/EXPOSE 
+	case V4L2_CID_GAIN:
+		ret = imx296_set_gain(imx296, ctrl->val);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = imx296_set_exposure(imx296, ctrl->val);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	mutex_unlock(&imx296->power_lock);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx296_ctrl_ops = {
+	.s_ctrl = imx296_s_ctrl,
+};
