+static int imx296_s_stream(struct v4l2_subdev *subdev, int enable)
+{
+	struct imx296 *imx296 = to_imx296(subdev);
+	int ret;
+
+	if (enable) {
+		ret = imx296_set_register_array(imx296,
+			imx296_init_settings,
+			ARRAY_SIZE(imx296_init_settings));
+		if (ret < 0) {
+			dev_err(imx296->dev,
+				"could not set init registers\n");
+			return ret;
+		}
+	
+		ret = imx296_set_register_array(imx296,
+					imx296->current_mode->data,
+					imx296->current_mode->data_size);
+		if (ret < 0) {
+			dev_err(imx296->dev, "could not set mode %dx%d\n",
+				imx296->current_mode->width,
+				imx296->current_mode->height);
+			return ret;
+		}
+		ret = v4l2_ctrl_handler_setup(&imx296->ctrls);
+		if (ret < 0) {
+			dev_err(imx296->dev, "could not sync v4l2 controls\n");
+			return ret;
+		}
+
+		ret = imx296_write_reg(imx296, STANDBY, 0x00);
+		if (ret < 0)
+			return ret;
+		msleep(10);
+		
+		
+		ret = imx296_write_reg(imx296, XMSTA, 0x00);
+		if (ret < 0)
+			return ret;
+
+		imx296->streaming = enable;
+	} else {
+		imx296->streaming = false;
+		ret = imx296_write_reg(imx296, XMSTA, 0x01);
+		if (ret < 0)
+			return ret;
+		msleep(10);
+		
+		ret = imx296_write_reg(imx296, STANDBY, 0x01);
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
+
+static const struct v4l2_subdev_core_ops imx296_core_ops = {
+	.s_power = imx296_s_power,
+};
+
+static const struct v4l2_subdev_video_ops imx296_video_ops = {
+	.g_frame_interval = imx296_g_frame_interval,
+	.s_frame_interval = imx296_s_frame_interval,
+	.s_stream = imx296_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops imx296_subdev_pad_ops = {
+	.init_cfg = imx296_entity_init_cfg,
+	.enum_mbus_code = imx296_enum_mbus_code,
+	.enum_frame_size = imx296_enum_frame_size,
+	.get_fmt = imx296_get_format,
+	.set_fmt = imx296_set_format,
+	.get_selection = imx296_get_selection,
+	.enum_frame_interval = imx296_enum_frame_interval,
+};
+
+static const struct v4l2_subdev_ops imx296_subdev_ops = {
+	.core = &imx296_core_ops,
+	.video = &imx296_video_ops,
+	.pad = &imx296_subdev_pad_ops,
+};
+
+static int imx296_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct device_node *endpoint;
+	struct imx296 *imx296;
+	u8 chip_id_high, chip_id_low;
+	u32 xclk_freq;
+	int ret;
+
+	imx296 = devm_kzalloc(dev, sizeof(struct imx296), GFP_KERNEL);
+	if (!imx296)
+		return -ENOMEM;
+
+	imx296->i2c_client = client;
+	imx296->dev = dev;
+
+	endpoint = of_graph_get_next_endpoint(dev->of_node, NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_parse(of_fwnode_handle(endpoint),
+					 &imx296->ep);
+
+	of_node_put(endpoint);
+
+	if (ret < 0) {
+		dev_err(dev, "parsing endpoint node failed\n");
+		return ret;
+	}
+
+	if (imx296->ep.bus_type != V4L2_MBUS_CSI2_DPHY) {
+		dev_err(dev, "invalid bus type, must be CSI2\n");
+		return -EINVAL;
+	}
+
+	/* get system clock (xclk) */
+	imx296->xclk = devm_clk_get(dev, "xclk");
+	if (IS_ERR(imx296->xclk)) {
+		dev_err(dev, "could not get xclk");
+		return PTR_ERR(imx296->xclk);
+	}
+
+	ret = of_property_read_u32(dev->of_node, "clock-frequency", &xclk_freq);
+	if (ret) {
+		dev_err(dev, "could not get xclk frequency\n");
+		return ret;
+	}
+
+	/* external clock must be 24MHz, allow 1% tolerance */
+	if (xclk_freq < 37000000 || xclk_freq > 37250000) {
+		dev_err(dev, "external clock frequency %u is not supported\n",
+			xclk_freq);
+		return -EINVAL;
+	}
+
+	ret = clk_set_rate(imx296->xclk, xclk_freq);
+	if (ret) {
+		dev_err(dev, "could not set xclk frequency\n");
+		return ret;
+	}
+
+	imx296->enable_gpio = devm_gpiod_get(dev, "enable", GPIOD_OUT_HIGH);
+	if (IS_ERR(imx296->enable_gpio)) {
+		dev_err(dev, "cannot get enable gpio\n");
+		return PTR_ERR(imx296->enable_gpio);
+	}
+
+	imx296->rst_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(imx296->rst_gpio)) {
+		dev_err(dev, "cannot get reset gpio\n");
+		return PTR_ERR(imx296->rst_gpio);
+	}
+
+	mutex_init(&imx296->power_lock);
+	
+	v4l2_ctrl_handler_init(&imx296->ctrls, 5);
+// [ISP Support PKG] Enabled to set GAIN/EXPOSE 
+	v4l2_ctrl_new_std(&imx296->ctrls, &imx296_ctrl_ops,
+			  V4L2_CID_GAIN, 0, 48, 1, 1);
+	v4l2_ctrl_new_std(&imx296->ctrls, &imx296_ctrl_ops,
+			  V4L2_CID_EXPOSURE, 0, 0xFFFF0, 1, 1);
+	v4l2_ctrl_new_std_menu_items(&imx296->ctrls, &imx296_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx296_test_pattern_menu) - 1,
+				     0, 0, imx296_test_pattern_menu);
+	imx296->pixel_clock = v4l2_ctrl_new_std(&imx296->ctrls,
+						&imx296_ctrl_ops,
+						V4L2_CID_PIXEL_RATE,
+						1, INT_MAX, 1, 145000000);
+	imx296->link_freq = v4l2_ctrl_new_int_menu(&imx296->ctrls,
+						   &imx296_ctrl_ops,
+						   V4L2_CID_LINK_FREQ,
+						   ARRAY_SIZE(link_freq) - 1,
+						   0, link_freq);
+	if (imx296->link_freq)
+		imx296->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx296->sd.ctrl_handler = &imx296->ctrls;
+
+	if (imx296->ctrls.error) {
+		dev_err(dev, "%s: control initialization error %d\n",
+		       __func__, imx296->ctrls.error);
+		ret = imx296->ctrls.error;
+		goto free_ctrl;
+	}
+
+	v4l2_i2c_subdev_init(&imx296->sd, client, &imx296_subdev_ops);
+	imx296->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx296->pad.flags = MEDIA_PAD_FL_SOURCE;
+	imx296->sd.dev = &client->dev;
+	imx296->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	ret = media_entity_pads_init(&imx296->sd.entity, 1, &imx296->pad);
+	if (ret < 0) {
+		dev_err(dev, "could not register media entity\n");
+		goto free_ctrl;
+	}
+
+	ret = imx296_s_power(&imx296->sd, true);
+	if (ret < 0) {
+		dev_err(dev, "could not power up IMX296\n");
+		goto free_entity;
+	}
+
+	dev_info(dev, "IMX296 detected at address 0x%02x\n", client->addr);
+
+	imx296_s_power(&imx296->sd, false);
+
+	ret = v4l2_async_register_subdev(&imx296->sd);
+	if (ret < 0) {
+		dev_err(dev, "could not register v4l2 device\n");
+		goto free_entity;
+	}
+
+	imx296_entity_init_cfg(&imx296->sd, NULL);
+
+	return 0;
+
+power_down:
+	imx296_s_power(&imx296->sd, false);
+free_entity:
+	media_entity_cleanup(&imx296->sd.entity);
+free_ctrl:
+	v4l2_ctrl_handler_free(&imx296->ctrls);
+	mutex_destroy(&imx296->power_lock);
+
+	return ret;
+}
+
+static int imx296_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx296 *imx296 = to_imx296(sd);
+
+	v4l2_async_unregister_subdev(&imx296->sd);
+	media_entity_cleanup(&imx296->sd.entity);
+	v4l2_ctrl_handler_free(&imx296->ctrls);
+	mutex_destroy(&imx296->power_lock);
+
+	return 0;
+}
+
+static const struct i2c_device_id imx296_id[] = {
+	{ "imx296", 0 },
+	{}
+};
+MODULE_DEVICE_TABLE(i2c, imx296_id);
+
+static const struct of_device_id imx296_of_match[] = {
+	{ .compatible = "sony,imx296" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, imx296_of_match);
+
+static struct i2c_driver imx296_i2c_driver = {
+	.driver = {
+		.of_match_table = of_match_ptr(imx296_of_match),
+		.name  = "imx296",
+	},
+	.probe_new  = imx296_probe,
+	.remove = imx296_remove,
+	.id_table = imx296_id,
+};
+
+module_i2c_driver(imx296_i2c_driver);
+
+MODULE_DESCRIPTION("IMX296 Image Sensor driver");
+MODULE_AUTHOR("FRAMOS GmbH");
+MODULE_LICENSE("GPL v2");
