+static int imx296_g_frame_interval(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_frame_interval *fi)
+{
+	struct imx296 *sensor = to_imx296(sd);
+
+	mutex_lock(&sensor->power_lock);
+	fi->interval = sensor->frame_interval;
+	mutex_unlock(&sensor->power_lock);
+
+	return 0;
+}
+
+static int imx296_s_frame_interval(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_frame_interval *fi)
+{
+	struct imx296 *sensor = to_imx296(sd);
+	const struct imx296_mode_info *mode;
+	int frame_rate, ret = 0;
+
+	if (fi->pad != 0)
+		return -EINVAL;
+
+	mutex_lock(&sensor->power_lock);
+
+	if (sensor->streaming) {
+		ret = -EBUSY;
+		goto out;
+	}
+
+	mode = sensor->current_mode;
+
+	frame_rate = imx296_try_frame_interval(sensor, &fi->interval,
+					       mode->width, mode->height);
+	if (frame_rate < 0)
+		frame_rate = IMX296_30_FPS; // was 60 fps
+
+	mode = imx296_find_mode(sensor, frame_rate, mode->width,
+				mode->height, true);
+	if (!mode) {
+		ret = -EINVAL;
+		goto out;
+	}
+	
+	pr_info("Frame rate: %d\n", frame_rate);
+
+	if (mode != sensor->current_mode ||
+	    frame_rate != sensor->current_fr) {
+		sensor->current_fr = frame_rate;
+		sensor->frame_interval = fi->interval;
+		sensor->current_mode = mode;
+	}
+out:
+	mutex_unlock(&sensor->power_lock);
+	return ret;
+}
