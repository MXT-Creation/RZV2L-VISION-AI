+static int imx296_set_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_pad_config *cfg,
+			     struct v4l2_subdev_format *format)
+{
+	struct imx296 *imx296 = to_imx296(sd);
+	struct v4l2_mbus_framefmt *__format;
+	struct v4l2_rect *__crop;
+	const struct imx296_mode_info *new_mode;
+	int ret;
+
+	__crop = __imx296_get_pad_crop(imx296, cfg, format->pad,
+			format->which);
+	new_mode = v4l2_find_nearest_size(imx296_mode_info_data,
+			       ARRAY_SIZE(imx296_mode_info_data),
+			       width, height,
+			       format->format.width, format->format.height);
+
+	__crop->width = new_mode->width;
+	__crop->height = new_mode->height;
+
+	if (format->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		ret = v4l2_ctrl_s_ctrl(imx296->link_freq,
+				       new_mode->link_freq);
+		if (ret < 0)
+			return ret;
+
+		imx296->current_mode = new_mode;
+	}
+
+	__format = __imx296_get_pad_format(imx296, cfg, format->pad,
+			format->which);
+	__format->width = __crop->width;
+	__format->height = __crop->height;
+    __format->code = MEDIA_BUS_FMT_SRGGB10_1X10;   // [ISP Support PKG] YUV -> RAW10
+	__format->field = V4L2_FIELD_NONE;
+	__format->colorspace = V4L2_COLORSPACE_SRGB;
+
+	format->format = *__format;
+
+	return 0;
+}
