+static int imx296_write_reg(struct imx296 *imx296, u16 reg, u8 val)
+{
+	u8 regbuf[3];
+	int ret;
+
+	regbuf[0] = reg >> 8;
+	regbuf[1] = reg & 0xff;
+	regbuf[2] = val;
+
+	ret = i2c_master_send(imx296->i2c_client, regbuf, 3);
+	if (ret < 0) {
+		dev_err(imx296->dev, "%s: write reg error %d: reg=%x, val=%x\n",
+			__func__, ret, reg, val);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int imx296_read_reg(struct imx296 *imx296, u16 reg, u8 *val)
+{
+	u8 regbuf[2];
+	int ret;
+
+	regbuf[0] = reg >> 8;
+	regbuf[1] = reg & 0xff;
+
+	ret = i2c_master_send(imx296->i2c_client, regbuf, 2);
+	if (ret < 0) {
+		dev_err(imx296->dev, "%s: write reg error %d: reg=%x\n",
+			__func__, ret, reg);
+		return ret;
+	}
+
+	ret = i2c_master_recv(imx296->i2c_client, val, 1);
+	if (ret < 0) {
+		dev_err(imx296->dev, "%s: read reg error %d: reg=%x\n",
+			__func__, ret, reg);
+		return ret;
+	}
+
+	return 0;
+}
+
+/**
+ * Reads multiple sequential registers at the same time using grouphold
+ */
+static int imx296_read_buffered_reg(struct imx296 *imx296,
+                                 u16 addr_low, u8 number_of_registers, u64 *val)
+{
+    struct device *dev = imx296->dev;
+    int err, i;
+    u8 reg;
+
+    *val = 0;
+
+    if (true){
+        err = imx296_write_reg(imx296, REGHOLD, 0x01);
+        if (err) {
+            dev_err(imx296->dev, "%s: error setting register hold\n", __func__);
+            return err;
+        }
+    }
+
+    for (i = 0; i < number_of_registers; i++) {
+        err = imx296_read_reg(imx296, addr_low + i, &reg);
+        *val += reg << (i * 8);
+        if (err) {
+            dev_err(imx296->dev, "%s: error reading buffered registers\n", __func__);
+            return err;
+        }
+    }
+
+    if (true){
+        err = imx296_write_reg(imx296, REGHOLD, 0x00);
+        if (err) {
+            dev_err(imx296->dev, "%s: error unsetting register hold\n", __func__);
+            return err;
+        }
+    }
+
+    return err;
+}
+
+/**
+ * Writes multiple sequential registers at the same time using reghold
+ */
+static int imx296_write_buffered_reg(struct imx296 *imx296, 
+                                u16 addr_low, u8 number_of_registers, u64 val)
+{
+    int err, i;
+	struct device *dev = imx296->dev;
+
+    if (true){
+        err = imx296_write_reg(imx296, REGHOLD, 0x01);
+        if (err) {
+            dev_err(imx296->dev, "%s: GRP_PARAM_HOLD error\n", __func__);
+            return err;
+        }
+    }
+
+    for (i = 0; i < number_of_registers; i++) {
+        err = imx296_write_reg(imx296, addr_low + i, (u8)(val >> (i * 8)));
+        if (err) {
+            dev_err(imx296->dev, "%s: BUFFERED register write error\n", __func__);
+            return err;
+        }
+    }
+
+    if (true){
+        err = imx296_write_reg(imx296, REGHOLD, 0x00);
+        if (err) {
+            dev_err(imx296->dev, "%s: GRP_PARAM_HOLD erroror\n", __func__);
+            return err;
+        }
+    }
+
+    return err;
+}
+
+static const struct imx296_mode_info *
+imx296_find_mode(struct imx296 *sensor, enum imx296_frame_rate fr,
+		 int width, int height, bool nearest)
+{
+	const struct imx296_mode_info *mode;
+
+	mode = v4l2_find_nearest_size(imx296_mode_info_data,
+			       ARRAY_SIZE(imx296_mode_info_data),
+			       width, height,
+			       width, height);
+	if (!mode ||
+	    (!nearest && (mode->width != width || mode->height != height)))
+		return NULL;
+
+	/* Check to see if the current mode exceeds the max frame rate */
+	if (imx296_framerates[fr] > imx296_framerates[mode->max_fps])
+		return NULL;
+
+	return mode;
+}
+
+static int imx296_set_register_array(struct imx296 *imx296,
+				     const struct reg_value *settings,
+				     unsigned int num_settings)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < num_settings; ++i, ++settings) {
+		ret = imx296_write_reg(imx296, settings->reg, settings->val);
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int imx296_set_power_on(struct imx296 *imx296)
+{
+	int ret;
+      pr_info("IMX296 sensor imx296_set_power_on - set GPIO to LOW\n");
+      gpiod_set_value_cansleep(imx296->enable_gpio, 0);
+      msleep(100);
+
+	ret = clk_prepare_enable(imx296->xclk);
+	if (ret < 0) {
+		dev_err(imx296->dev, "clk prepare enable failed\n");
+		return ret;
+	}
+
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(imx296->rst_gpio, 0);
+
+	msleep(20);
+
+	return 0;
+}
+
+static void imx296_set_power_off(struct imx296 *imx296)
+{
+	gpiod_set_value_cansleep(imx296->rst_gpio, 1);
+       msleep(20);
+	clk_disable_unprepare(imx296->xclk);
+}
+
+static int imx296_s_power(struct v4l2_subdev *sd, int on)
+{
+	struct imx296 *imx296 = to_imx296(sd);
+	int ret = 0;
+
+	mutex_lock(&imx296->power_lock);
+
+	/* If the power count is modified from 0 to != 0 or from != 0 to 0,
+	 * update the power state.
+	 */
+	if (imx296->power_count == !on) {
+		if (on) {
+                      pr_info("IMX296 sensor powered on always\n");
+			ret = imx296_set_power_on(imx296);
+			if (ret < 0)
+				goto exit;
+			usleep_range(500, 1000);
+		} else {
+			pr_info("IMX296 sensor powered off\n");
+			imx296_set_power_off(imx296);
+		}
+	}
+
+	/* Update the power count. */
+	imx296->power_count += on ? 1 : -1;
+	WARN_ON(imx296->power_count < 0);
+
+exit:
+	mutex_unlock(&imx296->power_lock);
+
+	return ret;
+}
+
+static int imx296_try_frame_interval(struct imx296 *sensor,
+				     struct v4l2_fract *fi,
+				     u32 width, u32 height)
+{
+	const struct imx296_mode_info *mode;
+	enum imx296_frame_rate rate = IMX296_30_FPS; // was 60 fps
+	int minfps, maxfps, best_fps, fps;
+	int i;
+
+	minfps = imx296_framerates[IMX296_30_FPS]; // was 60 fps
+	maxfps = imx296_framerates[IMX296_121_FPS];
+
+	if (fi->numerator == 0) {
+		fi->denominator = maxfps;
+		fi->numerator = 1;
+		rate = IMX296_121_FPS;
+		goto find_mode;
+	}
+
+	fps = clamp_val(DIV_ROUND_CLOSEST(fi->denominator, fi->numerator),
+			minfps, maxfps);
+
+	best_fps = minfps;
+	fps = clamp_val(DIV_ROUND_CLOSEST(fi->denominator, fi->numerator),
+			minfps, maxfps);	//why calling two times
+
+	for (i = 0; i < ARRAY_SIZE(imx296_framerates); i++) {
+		int curr_fps = imx296_framerates[i];
+
+		if (abs(curr_fps - fps) < abs(best_fps - fps)) {
+			best_fps = curr_fps;
+			rate = i;
+		}
+	}
+
+	fi->numerator = 1;
+	fi->denominator = best_fps;
+
+find_mode:
+	mode = imx296_find_mode(sensor, rate, width, height, false);
+	return mode ? rate : -EINVAL;
+}
+
+static int imx296_set_test_pattern(struct imx296 *imx296, s32 value)
+{	
+	int err;
+
+    	if (value) {
+        	err = imx296_write_reg(imx296, PATERN_GEN, (value << 3) + 7);
+        	if (err) 
+            		goto fail;
+  
+    	} else {
+        	err = imx296_write_reg(imx296, PATERN_GEN, 6);
+        	if (err) 
+           		goto fail;
+   	 }
+
+	dev_dbg(imx296->dev, "%s++ Test mode pattern: %u\n", __func__, value-1);
+
+    	return 0;
+fail:
+    	dev_err(imx296->dev, "%s: error setting test pattern\n", __func__);
+    	return err;
+}
