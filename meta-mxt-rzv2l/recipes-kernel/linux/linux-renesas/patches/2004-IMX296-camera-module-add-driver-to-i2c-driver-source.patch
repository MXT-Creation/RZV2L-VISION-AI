+
+	struct gpio_desc *enable_gpio;
+	struct gpio_desc *rst_gpio;
+
+	bool streaming;
+};
+
+static inline struct imx296 *to_imx296(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct imx296, sd);
+}
