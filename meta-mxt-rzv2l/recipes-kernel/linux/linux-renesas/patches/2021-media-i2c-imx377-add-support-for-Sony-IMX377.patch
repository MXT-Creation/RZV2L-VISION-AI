+static int imx377_apply_trimming(struct imx377 *sensor)
+{
+	u32 h_start, h_end;
+	u32 v_cut, v_pos, mdsel10;
+	int ret = 0;
+
+	h_start = sensor->crop.left + 48;
+	h_end = h_start + sensor->crop.width + 1;
+
+	v_pos = sensor->crop.top / 2;
+	v_cut = sensor->crop.height / 2;
+
+	ret |= imx377_write(sensor, IMX377_HTRIMMING_START, h_start);
+	ret |= imx377_write(sensor, IMX377_HTRIMMING_END, h_end);
+	ret |= imx377_write(sensor, IMX377_HTRIMMING_EN, 1);
+
+	ret |= imx377_write(sensor, IMX377_VWINPOS, v_pos);
+	ret |= imx377_write(sensor, IMX377_VWIDCUT, v_cut);
+
+	mdsel10 = sensor->crop.height;
+	ret |= imx377_write(sensor, IMX377_MDSEL10, mdsel10);
+	ret |= imx377_write(sensor, IMX377_MDSEL9, mdsel10 + 8 * 2);
+
+	ret |= imx377_write(sensor, IMX377_VWIDCUTEN, 1);
+
+	return ret;
+}
+static int imx377_setup(struct imx377 *sensor)
+{
+	const struct v4l2_mbus_framefmt *format;
+	const struct v4l2_rect *crop;
+	int ret = 0;
+
+	format = &sensor->format;
+	crop = &sensor->crop;
+
+	ret = imx377_write_array(sensor, imx377_init_table);
+	if (ret)
+		return ret;
+
+	ret = imx377_write_array(sensor, imx377_readout_mode1);
+	if (ret)
+		return ret;
+
+	ret = imx377_apply_trimming(sensor);
+	if (ret)
+		return ret;
+
+	if (sensor->lane_conf_regs) {
+		ret = imx377_write_array(sensor, sensor->lane_conf_regs);
+		if (ret)
+			return ret;
+	}
+
+	return ret;
+}
+
+static int imx377_stream_on(struct imx377 *sensor)
+{
+	int ret = 0;
+
+	ret |= imx377_write(sensor, IMX377_EBDDATAEN, 1);
+	ret |= imx377_write(sensor, IMX377_SMD, IMX377_SMD_ROLLING_SHUTTER);
+	ret |= imx377_write(sensor, IMX377_BLKLEVEL, IMX377_BLKLEVEL_DEFAULT);
+
+	ret = imx377_write(sensor, IMX377_CLPSQRST, 1);
+	ret |= imx377_write(sensor, IMX377_XMSTA, IMX377_XMSTA_MASTRE_MODE_START);
+	if (ret)
+		return ret;
+	usleep_range(50000, 70000);
+
+	return imx377_write(sensor, IMX377_CTRL00, IMX377_CTRL00_NORMAL_OPERATION);
+}
+
+static int imx377_stream_off(struct imx377 *sensor)
+{
+	int ret;
+
+	ret = imx377_write(sensor, IMX377_XMSTA, IMX377_XMSTA_MASTRE_MODE_STOP);
+	ret |= imx377_write(sensor, IMX377_CTRL00, IMX377_CTRL00_STANDBY);
+
+	return ret;
+}
+
+static int imx377_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct imx377 *sensor = to_imx377(sd);
+	int ret = 0;
+
+	mutex_lock(&sensor->lock);
+	if (!enable) {
+		imx377_stream_off(sensor);
+
+		pm_runtime_mark_last_busy(sensor->dev);
+		pm_runtime_put_autosuspend(sensor->dev);
+
+		sensor->streaming = false;
+
+		goto unlock;
+	}
+
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret < 0)
+		goto unlock;
+
+	ret = imx377_setup(sensor);
+	if (ret < 0)
+		goto err_pm;
+
+	/*
+	 * Set streaming to true to ensure __v4l2_ctrl_handler_setup() will set
+	 * the controls. The flag is reset to false further down if an error
+	 * occurs.
+	 */
+	sensor->streaming = true;
+
+	ret = __v4l2_ctrl_handler_setup(&sensor->ctrls);
+	if (ret < 0)
+		goto err_pm;
+
+	ret = imx377_stream_on(sensor);
+	if (ret)
+		goto err_pm;
+
+unlock:
+	mutex_unlock(&sensor->lock);
+
+	return ret;
+
+err_pm:
+	/*
+	 * In case of error, turn the power off synchronously as the device
+	 * likely has no other chance to recover.
+	 */
+	mutex_lock(&sensor->lock);
+	pm_runtime_put_sync(sensor->dev);
+	sensor->streaming = false;
+
+	goto unlock;
+}
+
+static int imx377_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_pad_config *cfg,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index != 0)
+		return -EINVAL;
+
+	code->code = IMX377_DEFAULT_DATAFMT;
+
+	return 0;
+}
+
+static int imx377_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_pad_config *cfg,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	const struct v4l2_mbus_framefmt *format;
+	struct imx377 *sensor = to_imx377(sd);
+
+	format = &sensor->format;
+
+	if (fse->index >= 1 || fse->code != format->code)
+		return -EINVAL;
+
+	fse->min_width = IMX377_PIXEL_ARRAY_WIDTH / (fse->index + 1);
+	fse->max_width = fse->min_width;
+	fse->min_height = IMX377_PIXEL_ARRAY_HEIGHT / (fse->index + 1);
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int imx377_get_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_pad_config *cfg,
+			     struct v4l2_subdev_format *fmt)
+{
+	struct imx377 *sensor = to_imx377(sd);
+
+	mutex_lock(&sensor->lock);
+	fmt->format = sensor->format;
+	mutex_unlock(&sensor->lock);
+
+	return 0;
+}
+
+static int imx377_set_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_pad_config *cfg,
+			     struct v4l2_subdev_format *fmt)
+{
+	struct imx377 *sensor = to_imx377(sd);
+	struct v4l2_mbus_framefmt *format;
+	struct v4l2_rect *crop;
+
+	crop = &sensor->crop;
+	format = &sensor->format;
+
+	mutex_lock(&sensor->lock);
+
+	format->width = crop->width;
+	format->height = crop->height;
+
+	format->code = IMX377_DEFAULT_DATAFMT;
+	format->field = V4L2_FIELD_NONE;
+	format->colorspace = V4L2_COLORSPACE_RAW;
+	format->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	format->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	format->xfer_func = V4L2_XFER_FUNC_NONE;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		cfg->try_fmt = *format;
+	else
+		fmt->format = *format;
+
+	mutex_unlock(&sensor->lock);
+	return 0;
+}
+
+static int imx377_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_pad_config *cfg,
+				struct v4l2_subdev_selection *sel)
+{
+	struct imx377 *sensor = to_imx377(sd);
+
+	mutex_lock(&sensor->lock);
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		if (sel->which == V4L2_SUBDEV_FORMAT_TRY)
+			sel->r = cfg->try_crop;
+		else
+			sel->r = sensor->crop;
+		break;
+
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = IMX377_PIXEL_ARRAY_WIDTH;
+		sel->r.height = IMX377_PIXEL_ARRAY_HEIGHT;
+		break;
+
+	default:
+		mutex_unlock(&sensor->lock);
+		return -EINVAL;
+	}
+	mutex_unlock(&sensor->lock);
+
+	return 0;
+}
+
+static int imx377_set_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_pad_config *cfg,
+				struct v4l2_subdev_selection *sel)
+{
+	struct imx377 *sensor = to_imx377(sd);
+	struct v4l2_mbus_framefmt *format;
+	struct v4l2_rect *crop;
+	struct v4l2_rect rect;
+
+	if (sel->target != V4L2_SEL_TGT_CROP)
+		return -EINVAL;
+
+	rect.left = clamp(ALIGN(sel->r.left, 12), 0,
+			  IMX377_PIXEL_ARRAY_WIDTH);
+	rect.top = clamp(ALIGN(sel->r.top, 1), 0,
+			 IMX377_PIXEL_ARRAY_HEIGHT);
+	rect.width = clamp_t(unsigned int, ALIGN(sel->r.width, 12),
+			     240, IMX377_PIXEL_ARRAY_WIDTH);
+	rect.height = clamp_t(unsigned int, ALIGN(sel->r.height, 2),
+			      2, IMX377_PIXEL_ARRAY_HEIGHT);
+
+	rect.width = min_t(unsigned int, rect.width,
+			   IMX377_PIXEL_ARRAY_WIDTH - rect.left);
+	rect.height = clamp_t(unsigned int, rect.height, 260,
+			    IMX377_PIXEL_ARRAY_HEIGHT - rect.top);
+
+	mutex_lock(&sensor->lock);
+	if (sel->which == V4L2_SUBDEV_FORMAT_TRY)
+		crop = &cfg->try_crop;
+	else
+		crop = &sensor->crop;
+
+	if (rect.width != crop->width || rect.height != crop->height) {
+		/*
+		 * Reset the output image size if the crop rectangle size has
+		 * been modified.
+		 */
+		format = &sensor->format;
+		format->width = rect.width;
+		format->height = rect.height;
+	}
+
+	*crop = rect;
+	sel->r = rect;
+	mutex_unlock(&sensor->lock);
+
+	return 0;
+}
+
+static int imx377_init_cfg(struct v4l2_subdev *sd,
+			   struct v4l2_subdev_pad_config *cfg)
+{
+	struct v4l2_subdev_selection sel = {
+		.target = V4L2_SEL_TGT_CROP,
+		.r.width = IMX377_PIXEL_ARRAY_WIDTH,
+		.r.height = IMX377_PIXEL_ARRAY_HEIGHT,
+	};
+	struct v4l2_subdev_format format = {
+		.format = {
+			.width = IMX377_PIXEL_ARRAY_WIDTH,
+			.height = IMX377_PIXEL_ARRAY_HEIGHT,
+		},
+	};
+
+	imx377_set_selection(sd, cfg, &sel);
+	imx377_set_format(sd, cfg, &format);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops imx377_subdev_video_ops = {
+	.s_stream = imx377_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops imx377_subdev_pad_ops = {
+	.enum_mbus_code = imx377_enum_mbus_code,
+	.enum_frame_size = imx377_enum_frame_size,
+	.get_fmt = imx377_get_format,
+	.set_fmt = imx377_set_format,
+	.get_selection = imx377_get_selection,
+	.set_selection = imx377_set_selection,
+	.init_cfg = imx377_init_cfg,
+};
+
+static const struct v4l2_subdev_ops imx377_subdev_ops = {
+	.video = &imx377_subdev_video_ops,
+	.pad = &imx377_subdev_pad_ops,
+};
+
+static int imx377_subdev_init(struct imx377 *sensor)
+{
+	struct i2c_client *client = to_i2c_client(sensor->dev);
+	int ret;
+
+	v4l2_i2c_subdev_init(&sensor->subdev, client, &imx377_subdev_ops);
+
+	ret = imx377_ctrls_init(sensor);
+	if (ret < 0)
+		return ret;
+
+	sensor->subdev.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+	sensor->subdev.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	ret = media_entity_pads_init(&sensor->subdev.entity, 1, &sensor->pad);
+	if (ret < 0) {
+		v4l2_ctrl_handler_free(&sensor->ctrls);
+		return ret;
+	}
+
+	return ret;
+}
+
+static void imx377_subdev_cleanup(struct imx377 *sensor)
+{
+	media_entity_cleanup(&sensor->subdev.entity);
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+}
+
+/* -----------------------------------------------------------------------------
+ * Power management
+ */
+
+static int __maybe_unused imx377_runtime_resume(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *subdev = i2c_get_clientdata(client);
+	struct imx377 *sensor = to_imx377(subdev);
+
+	return imx377_power_on(sensor);
+}
+
+static int __maybe_unused imx377_runtime_suspend(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *subdev = i2c_get_clientdata(client);
+	struct imx377 *sensor = to_imx377(subdev);
+
+	imx377_power_off(sensor);
+
+	return 0;
+}
+
+static const struct dev_pm_ops imx377_pm_ops = {
+	SET_RUNTIME_PM_OPS(imx377_runtime_suspend, imx377_runtime_resume, NULL)
+};
+
+/* -----------------------------------------------------------------------------
+ * Probe & Remove
+ */
+
+static const struct regmap_config imx377_regmap_config = {
+	.reg_bits = 16,
+	.val_bits = 8,
+	.cache_type = REGCACHE_RBTREE,
+};
+
+static int imx377_fwnode_parse(struct device *dev, struct imx377 *sensor)
+{
+	struct fwnode_handle *endpoint;
+	/* Only CSI2 is supported */
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY
+	};
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "Endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret == -ENXIO) {
+		dev_err(dev, "Unsupported bus type, should be CSI2\n");
+		return ret;
+	} else if (ret) {
+		dev_err(dev, "Parsing endpoint node failed %d\n", ret);
+		return ret;
+	}
+
+	/* Check number of data lanes, only 4 lanes supported */
+	switch (ep.bus.mipi_csi2.num_data_lanes) {
+	case 2:
+		sensor->lane_conf_regs = imx377_2_lane_conf;
+		fallthrough;
+	case 4:
+		break;
+	default:
+		dev_err(dev, "Invalid data lanes: %d\n",
+			ep.bus.mipi_csi2.num_data_lanes);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int imx377_probe(struct i2c_client *client)
+{
+	struct i2c_adapter *adapter = to_i2c_adapter(client->dev.parent);
+	unsigned long clk_rate;
+	struct imx377 *sensor;
+	unsigned int i;
+	int ret;
+
+	if (!i2c_check_functionality(adapter, I2C_FUNC_SMBUS_BYTE_DATA)) {
+		dev_warn(&adapter->dev,
+			 "I2C-Adapter doesn't support I2C_FUNC_SMBUS_BYTE\n");
+		return -EIO;
+	}
+
+	sensor = devm_kzalloc(&client->dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+
+	mutex_init(&sensor->lock);
+	sensor->dev = &client->dev;
+
+	ret = imx377_fwnode_parse(&client->dev, sensor);
+	if (ret)
+		return ret;
+
+	/* Acquire resources. */
+	for (i = 0; i < ARRAY_SIZE(sensor->supplies); ++i)
+		sensor->supplies[i].supply = imx377_supply_names[i];
+
+	ret = devm_regulator_bulk_get(sensor->dev, ARRAY_SIZE(sensor->supplies),
+				      sensor->supplies);
+	if (ret) {
+		dev_err_probe(sensor->dev, ret, "failed to get supplies\n");
+		return ret;
+	}
+
+	sensor->reset = devm_gpiod_get_optional(sensor->dev, "reset",
+						GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset))
+		return dev_err_probe(sensor->dev, PTR_ERR(sensor->reset),
+				     "failed to get reset GPIO\n");
+
+	sensor->clk = devm_clk_get(sensor->dev, "inck");
+	if (IS_ERR(sensor->clk))
+		return dev_err_probe(sensor->dev, PTR_ERR(sensor->clk),
+				     "failed to get clock\n");
+
+	clk_rate = clk_get_rate(sensor->clk);
+	if (clk_rate != IMX377_DEFAULT_CLK_FREQ) {
+		dev_err(sensor->dev,
+			"unsupported clock rate %lu, driver supports %u\n",
+			clk_rate, IMX377_DEFAULT_CLK_FREQ);
+		return -EINVAL;
+	}
+
+	sensor->regmap = devm_regmap_init_i2c(client, &imx377_regmap_config);
+	if (IS_ERR(sensor->regmap))
+		return PTR_ERR(sensor->regmap);
+
+	/*
+	 * Enable power management. The driver supports runtime PM, but needs to
+	 * work when runtime PM is disabled in the kernel. To that end, power
+	 * the sensor on manually here, identify it, and fully initialize it.
+	 */
+	ret = imx377_power_on(sensor);
+	if (ret < 0)
+		return ret;
+
+	ret = imx377_stream_off(sensor);
+	if (ret < 0) {
+		dev_err(sensor->dev, "Cannot talk to the sensor %d\n", ret);
+		goto err_power;
+	}
+
+	sensor->crop.top = 0;
+	sensor->crop.left = 0;
+	sensor->crop.width = IMX377_PIXEL_ARRAY_WIDTH;
+	sensor->crop.height = IMX377_PIXEL_ARRAY_HEIGHT;
+
+	sensor->format.width = IMX377_PIXEL_ARRAY_WIDTH;
+	sensor->format.height = IMX377_PIXEL_ARRAY_HEIGHT;
+	sensor->format.field = V4L2_FIELD_NONE;
+	sensor->format.code = IMX377_DEFAULT_DATAFMT;
+	sensor->format.colorspace = V4L2_COLORSPACE_RAW;
+	sensor->format.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	sensor->format.quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	sensor->format.xfer_func = V4L2_XFER_FUNC_NONE;
+
+	/* Initialize the V4L2 subdev. */
+	ret = imx377_subdev_init(sensor);
+	if (ret < 0)
+		goto err_power;
+
+	sensor->ctrls.lock = &sensor->lock;
+
+	/*
+	 * Enable runtime PM. As the device has been powered manually, mark it
+	 * as active, and increase the usage count without resuming the device.
+	 */
+	pm_runtime_set_active(sensor->dev);
+	pm_runtime_get_noresume(sensor->dev);
+	pm_runtime_enable(sensor->dev);
+
+	/* Register the V4L2 subdev. */
+	ret = v4l2_async_register_subdev(&sensor->subdev);
+	if (ret < 0)
+		goto err_pm;
+
+	/*
+	 * Finally, enable autosuspend and decrease the usage count. The device
+	 * will get suspended after the autosuspend delay, turning the power
+	 * off.
+	 */
+	pm_runtime_set_autosuspend_delay(sensor->dev, 1000);
+	pm_runtime_use_autosuspend(sensor->dev);
+	pm_runtime_put_autosuspend(sensor->dev);
+
+	return 0;
+
+err_pm:
+	pm_runtime_disable(sensor->dev);
+	pm_runtime_put_noidle(sensor->dev);
+	imx377_subdev_cleanup(sensor);
+err_power:
+	imx377_power_off(sensor);
+	return ret;
+}
+
+static int imx377_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *subdev = i2c_get_clientdata(client);
+	struct imx377 *sensor = to_imx377(subdev);
+
+	v4l2_async_unregister_subdev(subdev);
+
+	imx377_subdev_cleanup(sensor);
+
+	/*
+	 * Disable runtime PM. In case runtime PM is disabled in the kernel,
+	 * make sure to turn power off manually.
+	 */
+	pm_runtime_disable(sensor->dev);
+	if (!pm_runtime_status_suspended(sensor->dev))
+		imx377_power_off(sensor);
+	pm_runtime_set_suspended(sensor->dev);
+
+	return 0;
+}
+
+static const struct of_device_id imx377_of_match[] = {
+	{ .compatible = "sony,imx377", .data = NULL },
+	{ /* sentinel */ },
+};
+MODULE_DEVICE_TABLE(of, imx377_of_match);
+
+static struct i2c_driver imx377_i2c_driver = {
+	.driver = {
+		.of_match_table = imx377_of_match,
+		.name = "imx377",
+		.pm = &imx377_pm_ops
+	},
+	.probe_new = imx377_probe,
+	.remove = imx377_remove,
+};
+
+module_i2c_driver(imx377_i2c_driver);
+
+MODULE_DESCRIPTION("Sony IMX377 Camera driver");
