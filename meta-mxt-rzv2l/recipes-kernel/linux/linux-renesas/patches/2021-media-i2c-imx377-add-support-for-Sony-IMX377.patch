+static int imx377_write_array(struct imx377 *sensor, const struct imx377_reg *regs)
+{
+	int ret = 0;
+	size_t i;
+
+	for (i = 0; regs[i].reg != IMX377_TABLE_END; ++i) {
+		if (regs[i].reg == IMX377_TABLE_WAIT_MS) {
+			msleep(regs[i].value);
+			continue;
+		}
+		ret = imx377_write(sensor, regs[i].reg, regs[i].value);
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
