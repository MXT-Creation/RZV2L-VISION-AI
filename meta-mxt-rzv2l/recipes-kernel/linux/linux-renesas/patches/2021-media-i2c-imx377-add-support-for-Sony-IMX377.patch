index 000000000000..58a777d7f0c4
--- /dev/null
+++ b/drivers/media/i2c/imx377.c
@@ -0,0 +1,1374 @@
+/*
+ * Driver for IMX377 CMOS Image Sensor from Sony
+ *
+ * Based on imx296 driver.
+ * Copyright 2019 Laurent Pinchart <laurent.pinchart@ideasonboard.com>
+ *
+ * Adapted from IMX377 driver from nVDIDIA JetPack.
+ */
+
+#include <linux/clk.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+#include <linux/videodev2.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define IMX377_REG_8BIT(n)		((1 << 16) | (n))
+#define IMX377_REG_16BIT(n)		((2 << 16) | (n))
+#define IMX377_REG_24BIT(n)		((3 << 16) | (n))
+#define IMX377_REG_SIZE_SHIFT		16
+#define IMX377_REG_ADDR_MASK		0xffff
+
+#define IMX377_CTRL00			IMX377_REG_8BIT(0x3000)
+#define IMX377_CTRL00_STANDBY		0x01
+#define IMX377_CTRL00_NORMAL_OPERATION	0x00
+
+#define IMX377_CLPSQRST			IMX377_REG_8BIT(0x3001)
+#define IMX377_XMSTA			IMX377_REG_8BIT(0x30F4)
+#define IMX377_XMSTA_MASTRE_MODE_START	0
+#define IMX377_XMSTA_MASTRE_MODE_STOP	1
+
+#define IMX377_EBDDATAEN		IMX377_REG_8BIT(0x3799)
+#define IMX377_SMD			IMX377_REG_8BIT(0x3008)
+#define IMX377_SMD_ROLLING_SHUTTER	0
+
+#define IMX377_BLKLEVEL			IMX377_REG_8BIT(0x3045)
+#define IMX377_BLKLEVEL_DEFAULT		0x32
+
+/*
+ * Pixel rate value for INCK clock at 24 Mhz
+ */
+#define IMX377_PIXEL_RATE_DEFAULT	(288000000)
+
+/* default image data format */
+#define IMX377_DEFAULT_DATAFMT		MEDIA_BUS_FMT_SRGGB10_1X10
+/* minimum frame length */
+#define IMX377_MIN_FRAME_LENGTH		(3080)
+/* maximum frame length */
+#define IMX377_MAX_FRAME_LENGTH		(0xFFFF)
+
+/* maximum coarse time */
+#define IMX377_MAX_SHR			(IMX377_MAX_FRAME_LENGTH - 4)
+/* minimum SHS1 */
+#define IMX377_MIN_SHS1_1080P_HDR	(5)
+/* minimum SHS2 */
+#define IMX377_MIN_SHS2_1080P_HDR	(82)
+/* maximum SHS2 */
+#define IMX377_MAX_SHS2_1080P_HDR	(IMX377_MAX_FRAME_LENGTH - 5)
+/* maximum SHS1 */
+#define IMX377_MAX_SHS1_1080P_HDR	(IMX377_MAX_SHS2_1080P_HDR / 16)
+
+#define IMX377_HMAX				IMX377_REG_16BIT(0x30F5)
+
+/* frame length add */
+#define IMX377_VMAX				IMX377_REG_24BIT(0x30F7)
+/* shs1 coarse time */
+#define IMX377_EXPOSURE_SHR			IMX377_REG_16BIT(0x300B)
+#define IMX377_EXPOSURE_MIN			0
+#define IMX377_EXPOSURE_MAX			3200
+#define IMX377_EXPOSURE_DFLT			100
+#define IMX377_EXPOSURE_SVR			IMX377_REG_16BIT(0x300D)
+
+#define IMX377_ANALOGUE_GAIN			IMX377_REG_16BIT(0x3009)
+#define IMX377_ANALOGUE_GAIN_MIN		0
+#define IMX377_ANALOGUE_GAIN_MAX		0x7A5
+#define IMX377_ANALOGUE_GAIN_DFLT		0x3D2
+
+#define IMX377_DIGITAL_GAIN			IMX377_REG_8BIT(0x3011)
+#define IMX377_DIGITAL_GAIN_MIN			0
+#define IMX377_DIGITAL_GAIN_MAX			3
+#define IMX377_DIGITAL_GAIN_DFLT		2
+
+#define IMX377_GROUP_HOLD_ADDR			IMX377_REG_8BIT(0x302D)
+
+/* Horizontal cropping */
+#define IMX377_HTRIMMING_EN			IMX377_REG_8BIT(0x3040)
+#define IMX377_HTRIMMING_START			IMX377_REG_16BIT(0x303E)
+#define IMX377_HTRIMMING_END			IMX377_REG_16BIT(0x3039)
+
+/* Vertical cropping */
+#define IMX377_VWIDCUTEN			IMX377_REG_8BIT(0x30D5)
+#define IMX377_VWINPOS				IMX377_REG_16BIT(0x30D8)
+#define IMX377_VWIDCUT				IMX377_REG_16BIT(0x30D6)
+#define IMX377_MDSEL9				IMX377_REG_16BIT(0x312F)
+#define IMX377_MDSEL10				IMX377_REG_16BIT(0x3131)
+
+/* default output clk frequency for camera */
+#define IMX377_DEFAULT_CLK_FREQ			24000000
+
+#define IMX377_PIXEL_ARRAY_WIDTH		3912 /* HNUM is 3912 in datasheet */
+#define IMX377_PIXEL_ARRAY_HEIGHT		2174
+
+#define IMX377_TABLE_WAIT_MS			0
+#define IMX377_TABLE_END			1
+
+static const char * const imx377_supply_names[] = {
+	"dvdd",
+	"ovdd",
+	"avdd",
+};
+
+struct imx377_reg {
+	unsigned int reg;
+	unsigned int value;
+};
+
+struct imx377 {
+	struct device *dev;
+	struct clk *clk;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(imx377_supply_names)];
+	struct gpio_desc *reset;
+	struct regmap *regmap;
+
+	bool streaming;
+
+	struct v4l2_subdev subdev;
+	struct media_pad pad;
+
+	const struct imx377_reg *lane_conf_regs;
+
+	struct mutex lock; /* mutex lock for operations */
+	struct v4l2_rect crop;
+	struct v4l2_mbus_framefmt format;
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+};
+
+static inline struct imx377 *to_imx377(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct imx377, subdev);
+}
+
+#ifdef CURRENTLY_NOT_NEEDED
+static int imx377_read(struct imx377 *sensor, u32 addr)
+{
+	u8 data[3] = { 0, 0, 0 };
+	int ret;
+
+	ret = regmap_raw_read(sensor->regmap, addr & IMX377_REG_ADDR_MASK, data,
+			      (addr >> IMX377_REG_SIZE_SHIFT) & 3);
+	if (ret < 0)
+		return ret;
+
+	return (data[2] << 16) | (data[1] << 8) | data[0];
+}
+#endif
+
+static int imx377_write(struct imx377 *sensor, u32 addr, u32 value)
+{
+	u8 data[3] = { value & 0xff, (value >> 8) & 0xff, value >> 16 };
+	int ret;
+
+	ret = regmap_raw_write(sensor->regmap, addr & IMX377_REG_ADDR_MASK,
+			       data, (addr >> IMX377_REG_SIZE_SHIFT) & 3);
+	if (ret < 0) {
+		dev_err(sensor->dev, "%u-bit write to 0x%04x failed: %d\n",
+			((addr >> IMX377_REG_SIZE_SHIFT) & 3) * 8,
+			addr & IMX377_REG_ADDR_MASK, ret);
+	}
+
+	return ret;
+}
+
+static int imx377_power_on(struct imx377 *sensor)
+{
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(sensor->supplies),
+				    sensor->supplies);
+	if (ret < 0)
+		return ret;
+
+	udelay(1);
+
+	ret = gpiod_direction_output(sensor->reset, 0);
+	if (ret < 0)
+		goto err_supply;
+
+	udelay(1);
+
+	ret = clk_prepare_enable(sensor->clk);
+	if (ret < 0)
+		goto err_reset;
+
+	usleep_range(100000, 200000);
+
+	return 0;
+
+err_reset:
+	gpiod_direction_output(sensor->reset, 1);
+err_supply:
+	regulator_bulk_disable(ARRAY_SIZE(sensor->supplies), sensor->supplies);
+	return ret;
+}
+
+static void imx377_power_off(struct imx377 *sensor)
+{
+	clk_disable_unprepare(sensor->clk);
+	gpiod_direction_output(sensor->reset, 1);
+	regulator_bulk_disable(ARRAY_SIZE(sensor->supplies), sensor->supplies);
+}
+
+/* -----------------------------------------------------------------------------
+ * Controls
+ */
+
+static int imx377_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx377 *sensor = container_of(ctrl->handler, struct imx377, ctrls);
+	const struct v4l2_mbus_framefmt *format;
+	int ret = 0;
+
+	if (!sensor->streaming)
+		return 0;
+
+	format = &sensor->format;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = imx377_write(sensor, IMX377_EXPOSURE_SHR, ctrl->val);
+		break;
+
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = imx377_write(sensor, IMX377_ANALOGUE_GAIN, ctrl->val);
+		break;
+
+	case V4L2_CID_DIGITAL_GAIN:
+		ret = imx377_write(sensor, IMX377_DIGITAL_GAIN, ctrl->val);
+		break;
+
+	case V4L2_CID_HBLANK:
+		ret = imx377_write(sensor, IMX377_HMAX, ctrl->val);
+		break;
+
+	case V4L2_CID_VBLANK:
+		ret = imx377_write(sensor, IMX377_VMAX, format->height + ctrl->val);
+		break;
+
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx377_ctrl_ops = {
+	.s_ctrl = imx377_s_ctrl,
+};
+
+static int imx377_ctrls_init(struct imx377 *sensor)
+{
+	struct v4l2_fwnode_device_properties props;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(sensor->dev, &props);
+	if (ret < 0)
+		return ret;
+
+	v4l2_ctrl_handler_init(&sensor->ctrls, 7);
+
+	v4l2_ctrl_new_std(&sensor->ctrls, &imx377_ctrl_ops,
+			  V4L2_CID_EXPOSURE,
+			  IMX377_EXPOSURE_MIN,
+			  IMX377_EXPOSURE_MAX, 1,
+			  IMX377_EXPOSURE_DFLT);
+	v4l2_ctrl_new_std(&sensor->ctrls, &imx377_ctrl_ops,
+			  V4L2_CID_ANALOGUE_GAIN, IMX377_ANALOGUE_GAIN_MIN,
+			  IMX377_ANALOGUE_GAIN_MAX, 1,
+			  IMX377_ANALOGUE_GAIN_DFLT);
+	v4l2_ctrl_new_std(&sensor->ctrls, &imx377_ctrl_ops,
+			  V4L2_CID_DIGITAL_GAIN, IMX377_DIGITAL_GAIN_MIN,
+			  IMX377_DIGITAL_GAIN_MAX, 1,
+			  IMX377_DIGITAL_GAIN_DFLT);
+
+	sensor->hblank = v4l2_ctrl_new_std(&sensor->ctrls, &imx377_ctrl_ops,
+					   V4L2_CID_HBLANK, 260,
+					   65536 - IMX377_PIXEL_ARRAY_WIDTH,
+					   1, 2220);
+
+	sensor->vblank = v4l2_ctrl_new_std(&sensor->ctrls, &imx377_ctrl_ops,
+					   V4L2_CID_VBLANK, 625,
+					   1048575 - IMX377_PIXEL_ARRAY_HEIGHT,
+					   1, 625);
+	/*
+	 * The sensor calculates the MIPI timings internally to achieve a bit
+	 * rate between 1122 and 1198 Mbps. The exact value is unfortunately not
+	 * reported, at least according to the documentation. Report a nominal
+	 * rate of 1188 Mbps as that is used by the datasheet in multiple
+	 * examples.
+	 */
+	v4l2_ctrl_new_std(&sensor->ctrls, NULL, V4L2_CID_PIXEL_RATE,
+			  IMX377_PIXEL_RATE_DEFAULT, IMX377_PIXEL_RATE_DEFAULT, 1,
+			  IMX377_PIXEL_RATE_DEFAULT);
+
+	v4l2_ctrl_new_fwnode_properties(&sensor->ctrls, &imx377_ctrl_ops,
+					&props);
+
+	if (sensor->ctrls.error) {
+		dev_err(sensor->dev, "failed to add controls (%d)\n",
+			sensor->ctrls.error);
+		v4l2_ctrl_handler_free(&sensor->ctrls);
+		return sensor->ctrls.error;
+	}
+
+	sensor->subdev.ctrl_handler = &sensor->ctrls;
+
+	return 0;
+}
+
+/* -----------------------------------------------------------------------------
+ * V4L2 Subdev Operations
+ */
+
