From 3796774be8e92645640164603f406514471dce91 Mon Sep 17 00:00:00 2001
From: Alexandru Ardelean <aardelean@baylibre.com>
Date: Sat, 23 Nov 2024 15:16:11 +0200
Subject: [PATCH] media: i2c: imx415: implement simple cropping

Signed-off-by: Alexandru Ardelean <aardelean@baylibre.com>
---
 drivers/media/i2c/imx415.c | 105 ++++++++++++++++++++++++++++++++++++-
 1 file changed, 104 insertions(+), 1 deletion(-)

diff --git a/drivers/media/i2c/imx415.c b/drivers/media/i2c/imx415.c
index 126ef062da2e..c0e0925fc657 100644
--- a/drivers/media/i2c/imx415.c
+++ b/drivers/media/i2c/imx415.c
@@ -28,6 +28,9 @@
 
 #define IMX415_NUM_CLK_PARAM_REGS 11
 
+#define IMX415_PIXEL_CROP_MIN_HWIDTH 24
+#define IMX415_PIXEL_CROP_MIN_VWIDTH 4
+
 #define IMX415_REG_8BIT(n)	  ((1 << 16) | (n))
 #define IMX415_REG_16BIT(n)	  ((2 << 16) | (n))
 #define IMX415_REG_24BIT(n)	  ((3 << 16) | (n))
@@ -46,6 +49,8 @@
 #define IMX415_BCWAIT_TIME	  IMX415_REG_16BIT(0x3008)
 #define IMX415_CPWAIT_TIME	  IMX415_REG_16BIT(0x300A)
 #define IMX415_WINMODE		  IMX415_REG_8BIT(0x301C)
+#define IMX415_WINMODE_ALL_PIXEL_AREA	0
+#define IMX415_WINMODE_CROPPING		4
 #define IMX415_ADDMODE		  IMX415_REG_8BIT(0x3022)
 #define IMX415_REVERSE		  IMX415_REG_8BIT(0x3030)
 #define IMX415_HREVERSE_SHIFT	  (0)
@@ -57,6 +62,10 @@
 #define IMX415_DRV		  IMX415_REG_8BIT(0x30C1)
 #define IMX415_VMAX		  IMX415_REG_24BIT(0x3024)
 #define IMX415_HMAX		  IMX415_REG_16BIT(0x3028)
+#define IMX415_PIX_HST		  IMX415_REG_16BIT(0x3040)
+#define IMX415_PIX_HWIDTH	  IMX415_REG_16BIT(0x3042)
+#define IMX415_PIX_VST		  IMX415_REG_16BIT(0x3044)
+#define IMX415_PIX_VWIDTH	  IMX415_REG_16BIT(0x3046)
 #define IMX415_SHR0		  IMX415_REG_24BIT(0x3050)
 #define IMX415_GAIN_PCG_0	  IMX415_REG_16BIT(0x3090)
 #define IMX415_AGAIN_MIN	  0
@@ -608,6 +617,7 @@ struct imx415 {
 
 	const struct imx415_clk_params *clk_params;
 
+	struct v4l2_rect crop;
 	struct v4l2_mbus_framefmt fmt;
 	struct mutex mutex;
 
@@ -969,6 +979,7 @@ static int imx415_set_mode(struct imx415 *sensor, int mode)
 
 static int imx415_setup(struct imx415 *sensor)
 {
+	const struct v4l2_rect *crop;
 	unsigned int i;
 	int ret;
 
@@ -979,7 +990,22 @@ static int imx415_setup(struct imx415 *sensor)
 			return ret;
 	}
 
-	return imx415_set_mode(sensor, sensor->cur_mode);
+	crop = &sensor->crop;
+
+	ret = imx415_set_mode(sensor, sensor->cur_mode);
+	if (ret)
+		return ret;
+
+	if (crop->width != IMX415_PIXEL_ARRAY_WIDTH ||
+	    crop->height != IMX415_PIXEL_ARRAY_HEIGHT) {
+		ret = imx415_write(sensor, IMX415_PIX_HST, crop->left);
+		ret |= imx415_write(sensor, IMX415_PIX_VST, crop->top * 2);
+		ret |= imx415_write(sensor, IMX415_PIX_HWIDTH, crop->width);
+		ret |= imx415_write(sensor, IMX415_PIX_VWIDTH, crop->height * 2);
+		ret |= imx415_write(sensor, IMX415_WINMODE, IMX415_WINMODE_CROPPING);
+	}
+
+	return ret;
 }
 
 static int imx415_wakeup(struct imx415 *sensor)
@@ -1146,10 +1172,19 @@ static int imx415_get_selection(struct v4l2_subdev *sd,
 				struct v4l2_subdev_pad_config *cfg,
 				struct v4l2_subdev_selection *sel)
 {
+	struct imx415 *sensor = to_imx415(sd);
+
 	switch (sel->target) {
 	case V4L2_SEL_TGT_CROP:
+		if (sel->which == V4L2_SUBDEV_FORMAT_TRY)
+			sel->r = cfg->try_crop;
+		else
+			sel->r = sensor->crop;
+		return 0;
+
 	case V4L2_SEL_TGT_CROP_DEFAULT:
 	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
 		sel->r.top = IMX415_PIXEL_ARRAY_TOP;
 		sel->r.left = IMX415_PIXEL_ARRAY_LEFT;
 		sel->r.width = IMX415_PIXEL_ARRAY_WIDTH;
@@ -1161,6 +1196,59 @@ static int imx415_get_selection(struct v4l2_subdev *sd,
 	return -EINVAL;
 }
 
+static int imx415_set_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_pad_config *cfg,
+				struct v4l2_subdev_selection *sel)
+{
+	struct imx415 *sensor = to_imx415(sd);
+	struct v4l2_mbus_framefmt *format;
+	struct v4l2_rect *crop;
+	struct v4l2_rect rect;
+
+	if (sel->target != V4L2_SEL_TGT_CROP)
+		return -EINVAL;
+
+	/*
+	 * Clamp the crop rectangle boundaries and align them to satisfy
+	 * hardware requirements.
+	 */
+	rect.left = clamp(ALIGN(sel->r.left, 2), 0,
+			  IMX415_PIXEL_ARRAY_WIDTH - IMX415_PIXEL_CROP_MIN_HWIDTH);
+	rect.top = clamp(ALIGN(sel->r.top, 4), 0,
+			 IMX415_PIXEL_ARRAY_HEIGHT - IMX415_PIXEL_CROP_MIN_VWIDTH);
+	rect.width = clamp_t(unsigned int, ALIGN(sel->r.width, 24),
+			     IMX415_PIXEL_CROP_MIN_HWIDTH, IMX415_PIXEL_ARRAY_WIDTH);
+	rect.height = clamp_t(unsigned int, ALIGN(sel->r.height, 4),
+			      IMX415_PIXEL_CROP_MIN_VWIDTH, IMX415_PIXEL_ARRAY_HEIGHT);
+
+	rect.width = min_t(unsigned int, rect.width,
+			   IMX415_PIXEL_ARRAY_WIDTH - rect.left);
+	rect.height = min_t(unsigned int, rect.height,
+			    IMX415_PIXEL_ARRAY_HEIGHT - rect.top);
+
+	mutex_lock(&sensor->mutex);
+	if (sel->which == V4L2_SUBDEV_FORMAT_TRY)
+		crop = &cfg->try_crop;
+	else
+		crop = &sensor->crop;
+
+	if (rect.width != crop->width || rect.height != crop->height) {
+		/*
+		 * Reset the output image size if the crop rectangle size has
+		 * been modified.
+		 */
+		format = &sensor->fmt;
+		format->width = rect.width;
+		format->height = rect.height;
+	}
+
+	*crop = rect;
+	sel->r = rect;
+	mutex_unlock(&sensor->mutex);
+
+	return 0;
+}
+
 static int imx415_init_cfg(struct v4l2_subdev *sd,
 			   struct v4l2_subdev_pad_config *cfg)
 {
@@ -1186,6 +1274,7 @@ static const struct v4l2_subdev_pad_ops imx415_subdev_pad_ops = {
 	.get_fmt = imx415_get_format,
 	.set_fmt = imx415_set_format,
 	.get_selection = imx415_get_selection,
+	.set_selection = imx415_set_selection,
 	.init_cfg = imx415_init_cfg,
 };
 
@@ -1468,6 +1557,20 @@ static int imx415_probe(struct i2c_client *client)
 	if (ret)
 		goto err_power;
 
+	sensor->fmt.width = IMX415_PIXEL_ARRAY_WIDTH;
+	sensor->fmt.height = IMX415_PIXEL_ARRAY_HEIGHT;
+	sensor->fmt.code = MEDIA_BUS_FMT_SGBRG10_1X10;
+	sensor->fmt.field = V4L2_FIELD_NONE;
+	sensor->fmt.colorspace = V4L2_COLORSPACE_RAW;
+	sensor->fmt.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	sensor->fmt.quantization = V4L2_QUANTIZATION_DEFAULT;
+	sensor->fmt.xfer_func = V4L2_XFER_FUNC_NONE;
+
+	sensor->crop.top = 0;
+	sensor->crop.left = 0;
+	sensor->crop.width = IMX415_PIXEL_ARRAY_WIDTH;
+	sensor->crop.height = IMX415_PIXEL_ARRAY_HEIGHT;
+
 	/*
 	 * Enable runtime PM. As the device has been powered manually, mark it
 	 * as active, and increase the usage count without resuming the device.
