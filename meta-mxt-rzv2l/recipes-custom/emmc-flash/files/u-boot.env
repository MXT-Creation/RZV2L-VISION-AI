baudrate=115200
bootargs=rw rootwait earlycon root=/dev/mmcblk1p1
bootsd=run sd1load; booti 0x48080000 - 0x48000000
bootemmc=run emmcload; booti 0x48080000 - 0x48000000
bootcmd_check=if mmc dev 1; then run bootsd; else run bootemmc; fi
bootcmd=run bootemmc
bootdelay=2
bootm_size=0x10000000 
dtb=r9a07g054l2-ov13850-smarc.dtb
emmcload=ext4load mmc 0:1 0x48080000 boot/Image;ext4load mmc 0:1 0x48000000 boot/${dtb};run prodemmcbootargs
fdtcontroladdr=bbf350d0
loadaddr=0x58000000
platform=k
prodemmcbootargs=setenv bootargs rw rootwait earlycon root=/dev/mmcblk0p1 
prodsdbootargs=setenv bootargs rw rootwait earlycon root=/dev/mmcblk1p1 
sd1load=ext4load mmc 1:1 0x48080000 boot/Image;ext4load mmc 1:1 0x48000000 boot/${dtb};run prodsdbootargs
stderr=serial@1004b800
stdin=serial@1004b800
stdout=serial@1004b800
