From 0945fa8de8a3f953f27ced315ed8288b5c54e2d8 Mon Sep 17 00:00:00 2001
From: canh dao <canh.dao.ct@renesas.com>
Date: Mon, 15 Jan 2024 14:45:04 +0700
Subject: [PATCH] enable-u-dma-buf-function

Signed-off-by: canh dao <canh.dao.ct@renesas.com>
---
 arch/arm64/boot/dts/renesas/r9a07g054l2-dev.dts   | 10 ++++++++++
 arch/arm64/boot/dts/renesas/r9a07g054l2-smarc.dts |  9 +++++++++
 2 files changed, 19 insertions(+)

diff --git a/arch/arm64/boot/dts/renesas/r9a07g054l2-dev.dts b/arch/arm64/boot/dts/renesas/r9a07g054l2-dev.dts
index f9a7b730e..56a7c9e62 100644
--- a/arch/arm64/boot/dts/renesas/r9a07g054l2-dev.dts
+++ b/arch/arm64/boot/dts/renesas/r9a07g054l2-dev.dts
@@ -67,6 +67,16 @@ mmngrbuf {
 	vspm_if {
 		compatible = "renesas,vspm_if";
 	};
+
+        udmabuf@0 {
+                compatible = "ikwzm,u-dma-buf";
+                device-name = "udmabuf0";
+                minor-number = <0>;
+                size = <0x4000000>; // 64MiB
+                dma-coherent;
+                memory-region = <&image_buf0>;
+        };
+
 };
 
 &ehci0 {
diff --git a/arch/arm64/boot/dts/renesas/r9a07g054l2-smarc.dts b/arch/arm64/boot/dts/renesas/r9a07g054l2-smarc.dts
index 26a1a2f60..e63ac846c 100644
--- a/arch/arm64/boot/dts/renesas/r9a07g054l2-smarc.dts
+++ b/arch/arm64/boot/dts/renesas/r9a07g054l2-smarc.dts
@@ -39,4 +39,13 @@ isp_work0: SIMPLE_ISP {
 			reg = <0x0 0xB4000000 0x0 0x03000000>;
 		};
 	};
+
+       udmabuf@0 {
+               compatible = "ikwzm,u-dma-buf";
+               device-name = "udmabuf0";
+               minor-number = <0>;
+               size = <0x4000000>; // 64MiB
+               dma-coherent;
+               memory-region = <&image_buf0>;
+       };
 };
-- 
2.25.1

